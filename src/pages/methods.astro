---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Methods">
  <div class="narrow">
    <h1>{site.methods.title}</h1>
    <p class="lead">{site.methods.subtitle}</p>

    {site.methods.sections.map((s, i) => (
      <details class="msec" open={i === 0}>
        <summary><span class="n">{s.n}</span><h3>{s.title}</h3><span class="arr">▶</span></summary>
        <div class="body">
          <p set:html={s.intro}></p>
          <ul>{s.items.map((it) => <li set:html={it} />)}</ul>
          {s.outro && <p set:html={s.outro}></p>}
        </div>
      </details>
    ))}
  </div>
</Base>
