---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { statusMap, categoryMap } from '../lib/catalog';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = projects.filter((p) => p.data.featured);

// 聚合所有项目的更新日志，按日期倒序取前 5 条
const updates = projects
  .flatMap((p) => p.data.updateLog.map((u) => ({ ...u, project: p.data.title })))
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 5);
---

<Base>
  <div class="page">
    <section class="hero">
      <div class="hello">{site.hero.tagline}</div>
      <h1>{site.hero.name}</h1>
      <div class="en">{site.hero.nameEn}</div>
      <div class="role">{site.hero.role}</div>
      <div class="pos">
        <span class="zh">{site.hero.posZh}</span>
        {site.hero.posEn}
      </div>
      <div class="btns">
        <a class="btn btn-main" href={`${base}lab/`}>{site.hero.btnLab}</a>
        <a class="btn btn-ghost" href="https://github.com/wsqs-hub" target="_blank" rel="noopener">{site.hero.btnGithub}</a>
      </div>
      <div class="domains">
        {site.hero.domains.map((d) => <span>{d}</span>)}
      </div>
    </section>

    <section class="sec">
      <div class="sec-head"><h2>{site.whatIBuild.title}</h2><span class="zh">{site.whatIBuild.titleZh}</span></div>
      <div class="cap-grid">
        {site.whatIBuild.cards.map((c, i) => (
          <a class="cap" href={`${base}lab/`}><span class="no">{String(i + 1).padStart(2, '0')}</span><h4>{c.title}</h4><div class="kw">{c.keywords.map((k) => <span>{k}</span>)}</div></a>
        ))}
      </div>
    </section>

    <section class="sec">
      <div class="sec-head"><h2>{site.featured.title}</h2><span class="zh">{site.featured.titleZh}</span><a class="more" href={`${base}lab/`}>{site.featured.viewAll}</a></div>
      <div class="feat-grid">
        {featured.map((p) => {
          const st = statusMap[p.data.status];
          const cat = categoryMap[p.data.category];
          return (
            <a class="fcard" href={`${base}lab/${p.id}/`}>
              <span class="no">{String(p.data.order).padStart(2, '0')}</span>
              <h4>{p.data.title}</h4>
              <span class="pipe">{p.data.pipeline}</span>
              <div class="desc">{p.data.summary}</div>
              <div class="tags">
                <span class={`badge ${st.cls}`}><i></i>{st.label}</span>
                <span class="badge b-line">{cat}</span>
              </div>
              <div class="read">Read →</div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="sec">
      <div class="sec-head"><h2>{site.updates.title}</h2><span class="zh">{site.updates.titleZh}</span><a class="more" href={`${base}lab/`}>{site.updates.viewLab}</a></div>
      <div class="upd-box">
        {updates.map((u) => (
          <div class="row"><span class="d">{u.date}</span><span class="p">{u.project}</span><span class="n">{u.note}</span></div>
        ))}
      </div>
    </section>
  </div>
</Base>
