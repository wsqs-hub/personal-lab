---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="About">
  <div class="narrow">
    <h1>{site.about.title}</h1>
    <p class="lead">{site.about.lead}</p>

    <div class="asec">
      <h2>Experience</h2>
      {site.about.experience.map((e) => (
        <div class="item">
          <div class="r"><h4>{e.role}</h4><span class="date">{e.date}</span></div>
          <p>{e.desc}</p>
        </div>
      ))}
    </div>

    <div class="asec">
      <h2>Education</h2>
      {site.about.education.map((e) => (
        <div class="item">
          <div class="r"><h4>{e.school}</h4><span class="date">{e.date}</span></div>
          {e.desc && <p>{e.desc}</p>}
        </div>
      ))}
    </div>

    <div class="asec">
      <h2>Skills</h2>
      <div class="skill-cloud">
        {site.about.skillsHot.map((s) => <span class="hot">{s}</span>)}
        {site.about.skills.map((s) => <span>{s}</span>)}
      </div>
    </div>

    <div class="asec">
      <h2>Resume</h2>
      <div style="padding-top:16px"><a class="btn btn-ghost" style="font-size:13px;padding:9px 20px" href={`mailto:${site.footer.emailAddress}`}>{site.about.resumeBtn}</a></div>
    </div>

    <div class="asec">
      <h2>Disclaimer</h2>
      <p style="padding-top:16px;font-size:13px;color:var(--ink-2)">{site.about.disclaimer}</p>
    </div>
  </div>
</Base>
