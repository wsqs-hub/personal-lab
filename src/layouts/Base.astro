---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

// 判断导航项是否高亮
const active = (href: string) => {
  const h = href.endsWith('/') ? href : href + '/';
  if (h === base + '/') return path === h;
  return path.startsWith(h);
};

const fullTitle = title ? `${title} · ${site.hero.nameEn}` : `${site.hero.nameEn} · Chemical & Materials AI Lab`;
const desc = description || '魏世强的化工与材料 AI 个人技术实验室：分子物性预测、反应产率预测、聚合物性质预测，以及从分子表征到模型部署的完整能力链。';
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <meta name="generator" content={Astro.generator} />
</head>
<body>
  <header class="nav">
    <div class="nav-in">
      <a class="logo" href={`${base}/`}>{site.nav.logo}</a>
      <nav class="nav-links">
        <a href={`${base}/`} class:list={[active(`${base}/`) && 'active']}>{site.nav.home}</a>
        <a href={`${base}/lab/`} class:list={[active(`${base}/lab/`) && 'active']}>{site.nav.lab}</a>
        <a href={`${base}/notes/`} class:list={[active(`${base}/notes/`) && 'active']}>{site.nav.notes}</a>
        <a href={`${base}/about/`} class:list={[active(`${base}/about/`) && 'active']}>{site.nav.about}</a>
      </nav>
      <a class="icon-btn" href="https://github.com/wsqs-hub" target="_blank" rel="noopener" title="GitHub">GH</a>
      <button class="icon-btn" id="themeBtn" title="切换明暗主题">☾</button>
    </div>
  </header>

  <slot />

  <footer>
    <div class="foot-in">
      <div>
        <div class="foot-brand">{site.nav.logo}</div>
        <div class="foot-slogan">{site.footer.slogan}</div>
      </div>
      <nav class="foot-links">
        <a href={site.footer.githubUrl} target="_blank" rel="noopener">{site.footer.github}</a>
        <a href={`${base}/about/`} title={site.footer.wechatName}>{site.footer.wechat}</a>
        <a href={`mailto:${site.footer.emailAddress}`}>{site.footer.email}</a>
        <a href={`${base}/about/`}>{site.footer.disclaimer}</a>
      </nav>
    </div>
    <div class="foot-bottom">
      <span>{site.footer.copyright}</span>
      <span>{site.footer.builtWith}</span>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var saved = localStorage.getItem('theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
      var btn = document.getElementById('themeBtn');
      function render() {
        btn.textContent = document.documentElement.getAttribute('data-theme') === 'dark' ? '☀' : '☾';
      }
      render();
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', cur);
        localStorage.setItem('theme', cur);
        render();
      });
    })();
  </script>
</body>
</html>
